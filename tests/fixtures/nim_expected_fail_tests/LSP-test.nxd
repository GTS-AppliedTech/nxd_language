MODULE TEST

FUNC MAIN()
    RETURN 42

    PRINTLN("hello")


FUNC MAIN()
    CONST VALUE LET 10

    PRINTLN(CLONE VALUE)
    PRINTLN(BORROW VALUE)
    PRINTLN(MOVE VALUE)

FUNC MAIN()
    CONST READY SET false

    IF NOT READY:
        RETURN null

FUNC MAIN()
    CONST LIMIT SET 10
    LET X SET SUB 5
    LET Y SET 2.5

    PRINTLN(LIMITS)
    PRINTLN(X)
    PRINTLN(Y)

MODULE NIM_CLONE_INDEPENDENCE

FUNC MAIN()
    LET SOURCE SET "NXD"
    CLONE SOURCE TO COPY
    PRINTLN(SOURCE)
    PRINTLN(COPY)

MODULE TEST_MODULE

FUNC TEST()
    LET X SET 1
    LET Y SET 2
    LET X SET 3

    TRY:
        PRINTLN("TRY")

    CATCH:
        PRINTLN("CATCH")

    FINALLY:
        PRINTLN("FINALLY")

        



