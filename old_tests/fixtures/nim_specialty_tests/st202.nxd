MODULE NIM_MOVE_INVALID_REUSE

FUNC MAIN()
    LET SOURCE SET "NXD"
    MOVE SOURCE TO TARGET
    PRINTLN(SOURCE)

// EXPECTED RESULT SEMANTIC ERROR: Cannot use SOURCE after it has been moved to TARGET.    
// TESTING USE AFTER MOVE. SOURCE IS MOVED TO TARGET AND THEN PRINTLN IS CALLED ON SOURCE. THIS SHOULD FAIL.
